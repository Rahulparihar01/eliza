# =============================================================================
# ELIZA Accelerate - Adoption Analytics Configuration
# =============================================================================
# Copy this file to .env and fill in the values below.
#
#   cp .env.template .env
#   # Edit .env with your values
#   docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# Container Images
# -----------------------------------------------------------------------------
# Images are hosted on GitHub Container Registry (GHCR).
# Authenticate before pulling:
#   echo "$GHCR_TOKEN" | docker login ghcr.io -u eliza-platform --password-stdin
ELIZA_IMAGE_REGISTRY=ghcr.io/eliza-platform/
ELIZA_IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Admin Account (REQUIRED - first-time setup)
# -----------------------------------------------------------------------------
# These credentials create the initial admin user on first boot.
# After first boot, set INIT_TENANT=false to skip re-initialization.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# -----------------------------------------------------------------------------
# Tenant Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Identifies your organization in the platform.
CUSTOMER_ID=yourcompany
CUSTOMER_NAME=Your Company Name

# Set to "true" on first deploy, then change to "false" after setup.
INIT_TENANT=true

# -----------------------------------------------------------------------------
# OpenAI API Key (REQUIRED)
# -----------------------------------------------------------------------------
# Used by the adoption sync service to pull data from the ChatGPT Enterprise
# Compliance API. The key must have the "compliance_export" scope.
# You will also need your ChatGPT Enterprise Workspace ID, which is
# configured through the Admin UI after deployment.
OPENAI_API_KEY=sk-proj-...

# -----------------------------------------------------------------------------
# Encryption Key (REQUIRED)
# -----------------------------------------------------------------------------
# Used to encrypt sensitive data at rest (e.g., provider API keys stored in
# the database). Generate one with:
#
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Or if you don't have Python:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# For the bundled PostgreSQL container, only DB_PASSWORD is required.
# To use an external database (e.g., Amazon RDS), set all DB_* values and
# remove the "postgres" service from docker-compose.yml.
DB_HOST=postgres
DB_PORT=5432
DB_USER=eliza
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=ai_enablement

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# For the bundled Redis container, defaults work out of the box.
# To use an external Redis (e.g., Amazon ElastiCache), set REDIS_HOST and
# remove the "redis" service from docker-compose.yml.
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Exposed Ports
# -----------------------------------------------------------------------------
# Change these if the defaults conflict with existing services on your host.
FRONTEND_PORT=3000
APP_PORT=5001

# -----------------------------------------------------------------------------
# CORS / Frontend URL
# -----------------------------------------------------------------------------
# Set to the URL users will access the platform at.
# Used for CORS headers and email invite links.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
